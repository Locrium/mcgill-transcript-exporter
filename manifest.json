{
  "manifest_version": 3,
  "name": "McGill Video Transcript Exporter",
  "version": "0.3.0",
  "description": "Export available video captions from Brightspace pages as Markdown, text, or WebVTT.",
  "permissions": ["activeTab", "downloads", "scripting", "storage", "webRequest"],
  "host_permissions": [
    "https://lrs.mcgill.ca/*",
    "https://lrswapi.campus.mcgill.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export video transcript",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/mcgill-transcript-logo.png",
      "32": "assets/mcgill-transcript-logo.png",
      "48": "assets/mcgill-transcript-logo.png",
      "128": "assets/mcgill-transcript-logo.png"
    }
  },
  "icons": {
    "16": "assets/mcgill-transcript-logo.png",
    "32": "assets/mcgill-transcript-logo.png",
    "48": "assets/mcgill-transcript-logo.png",
    "128": "assets/mcgill-transcript-logo.png"
  }
}
